# Entorno de ejecución: development, testing, production
FLASK_ENV=development

# Clave secreta para cookies de sesión (generar con secrets.token_hex(32))
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_por_un_hash_seguro

# Base de datos:
# MariaDB local: mysql+pymysql://root:password@localhost:3306/germania_db
# PostgreSQL (Render): postgresql://usuario:password@host/dbname
# SQLite (Testing/Fallback): sqlite:///germania.db
DATABASE_URL=sqlite:///germania.db

# Configuración de pesos de evaluación (Provisional y Configurable)
PESO_EVAL_SABER=0.40
PESO_EVAL_HACER=0.40
PESO_EVAL_SER=0.20
